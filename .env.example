# Data mode: "mock" (default, in-memory demo data) or "supabase".
# Supabase mode requires the two variables below.
VITE_DATA_MODE=mock

# Supabase project settings (Project Settings -> API).
# Only the publishable (anon) key belongs here. NEVER put the service-role key,
# PayMongo secret key, or Resend API key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# EmailJS order and account notifications (https://dashboard.emailjs.com).
# All five are optional: leave any of them blank and the app simply skips
# outbound email while still raising the in-app notifications.
#   - Service ID:  Email Services -> your service
#   - Public key:  Account -> General -> Public Key. Only the PUBLIC key belongs
#                  here; the EmailJS private key is a secret and must never go in
#                  a VITE_ variable.
#   - Templates:   Email Templates -> the template ID of each flow. Address the
#                  "new order" template to the store admin and the "order
#                  update" and "welcome" templates to {{to_email}} (the
#                  customer). "Welcome" greets a buyer once the emailed code has
#                  confirmed their address; the code itself comes from Supabase
#                  Auth, never from EmailJS.
# Template variables available to both order templates: store_name, store_email,
# store_phone, order_number, order_status, payment_method, payment_status,
# customer_name, customer_email, customer_phone, item_count, items, subtotal,
# shipping_fee, discount, total, shipping_address, customer_note, placed_at.
# New order adds admin_order_path; order update adds status_note, updated_at,
# tracking_courier, tracking_number, track_order_path. Welcome adds
# customer_first_name, shop_url and account_url next to customer_name and
# customer_email.
# Every send also carries to_email, to_name, subject and the sender identity
# from src/lib/email/branding.ts: from_name, logo_url and site_url. A template
# may use any of them, so the brand only ever changes in one place.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_NEW_ORDER=
VITE_EMAILJS_TEMPLATE_ORDER_UPDATE=
VITE_EMAILJS_TEMPLATE_WELCOME=
