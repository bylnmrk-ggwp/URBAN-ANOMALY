# Data mode: "mock" (default, in-memory demo data) or "supabase".
# Supabase mode requires the two variables below.
VITE_DATA_MODE=mock

# Supabase project settings (Project Settings -> API).
# Only the publishable (anon) key belongs here. NEVER put the service-role key,
# PayMongo secret key, or Resend API key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# EmailJS order notifications (https://dashboard.emailjs.com).
# All four are optional: leave any of them blank and the app simply skips
# outbound email while still raising the in-app notifications.
#   - Service ID:  Email Services -> your service
#   - Public key:  Account -> General -> Public Key. Only the PUBLIC key belongs
#                  here; the EmailJS private key is a secret and must never go in
#                  a VITE_ variable.
#   - Templates:   Email Templates -> the template ID of each flow. Address the
#                  "new order" template to the store admin and the "order
#                  update" template to {{to_email}} (the customer).
# Template variables available to both: store_name, store_email, store_phone,
# order_number, order_status, payment_method, payment_status, customer_name,
# customer_email, customer_phone, item_count, items, subtotal, shipping_fee,
# discount, total, shipping_address, customer_note, placed_at, to_email,
# to_name, subject. New order adds admin_order_path; order update adds
# status_note, updated_at, tracking_courier, tracking_number, track_order_path.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_NEW_ORDER=
VITE_EMAILJS_TEMPLATE_ORDER_UPDATE=
