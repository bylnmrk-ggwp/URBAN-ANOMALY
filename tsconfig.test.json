{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // "node": a few suites read project files from disk (vitest stubs CSS imports, `?raw`
    // included, so globals.css cannot be imported). Test-only; `src` itself stays DOM-only.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "node"],
    "noEmit": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/tests", "src/**/*.d.ts"],
  "exclude": []
}
